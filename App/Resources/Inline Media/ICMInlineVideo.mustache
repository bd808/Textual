
<span class="inlineVideo {{classAttribute}}" id="inlineMedia-{{uniqueIdentifier}}">
	<span class="closeButton" href="#" onclick="_ICMInlineVideo.hideOnClick('{{uniqueIdentifier}}');">×</span>

	<video

{{#videoAutoplayEnabled}}
		autoplay
		data-plays-by-itself="true"
{{/videoAutoplayEnabled}}

{{! A video you start yourself loads only its first frame and length until then }}
{{^videoAutoplayEnabled}}
		preload="metadata"
{{/videoAutoplayEnabled}}

{{#videoControlsEnabled}}
		controls
{{/videoControlsEnabled}}

{{#videoLoopEnabled}}
		loop
{{/videoLoopEnabled}}

{{#videoMuteEnabled}}
		muted
{{/videoMuteEnabled}}

		data-speed="{{videoPlaybackSpeed}}"
		data-start="{{videoStartTime}}"
		src="{{videoURL}}"
		class="content"
		style="max-width: {{preferredMaximumWidth}}px;"
		onloadedmetadata="_ICMInlineVideo.metadataLoadedCallback()"
		onloadeddata="_ICMInlineVideo.dataLoadedCallback()"
		onerror="_ICMInlineVideo.loadFailedCallback()"></video>
</span>
